<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 🟡 UNDERSTAND - You'll change these for each package -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <name>bluerov2_ros2</name>
  <version>0.0.1</version>
  <description>BlueROV2 ROS2 Simulation Package</description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>MIT</license>

  
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 🟢 TEMPLATE - Always the same for ament_cmake packages -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 🔴 CRITICAL - Dependencies (packages you need to run) -->
  <!-- You'll add more as you use new message types/packages -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 🟢 TEMPLATE - Always the same -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
  
</package>
